# PostgreSQL connection string from Neon (used by Prisma)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign/verify JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Resend API key, used to send booking confirmation/cancellation emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
