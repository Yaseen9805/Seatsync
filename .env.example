# PostgreSQL connection strings from Neon (used by Prisma).
# DATABASE_URL is the pooled connection, used by the app at runtime.
# DIRECT_URL is the non-pooled connection, used for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Secret used to sign/verify JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Resend API key, used to send booking confirmation/cancellation emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
